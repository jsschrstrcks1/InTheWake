      "kind": "claim",
      "subject": "change:20261107-itw-pwa-precache-tied-to-sw#why",
      "content": {
        "summary": "change:20261107-itw-pwa-precache-tied-to-sw why = \"Edits to the precache manifest never reached anyone who had already installed the site as an app, because the service worker only reads the manifest when sw.js itself changes, and three pages were added that way in May. The manifest also listed a file that does not exist, and the cruise tipping calculator was not precached, so a reader who opened it at home could not use it at sea.\"",
        "ref": null,
        "hash": null
      },
      "provenance": {
        "source_kind": "lexicon-statement",
